# Luxeit frontend environment — copy to .env.local for local dev.
# On Vercel, set these in Project Settings → Environment Variables.

# The app proxies /api/* to Django via next.config rewrites, so the browser
# always uses same-origin relative URLs. Leave this EMPTY (same-origin).
NEXT_PUBLIC_API_BASE_URL=

# Where the Next server proxies /api/* to (server-side rewrites + server
# components). Local dev: the Django dev server. Production (Vercel): your
# Render API URL, e.g. https://luxeit-api.onrender.com
BACKEND_ORIGIN=http://localhost:8000

# Desktop/tablet UI is under development, so big screens see a "use your phone"
# notice. Set to true (in Vercel) once the desktop UI is ready to retire it.
# NEXT_PUBLIC_DESKTOP_READY=true
