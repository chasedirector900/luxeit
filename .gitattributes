# Normalize line endings: store text as LF in the repo, check out native on each
# OS. Keeps the repo clean across Windows (dev) and Linux (deploy).
* text=auto eol=lf

# Treat these as binary (never normalize / diff as text).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
