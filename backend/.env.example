# Copy to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Next dev falls back to :3001 if :3000 is taken — both allowed in dev.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Database ---
# Unset = local SQLite (zero setup). Production: a Postgres URL — required on
# Render/Neon/etc, whose disks are wiped every deploy (SQLite would lose data).
# Render's blueprint (render.yaml) wires this automatically from luxeit-db.
# DATABASE_URL=postgresql://user:pass@host:5432/luxeit

# --- Production only ---
# In production set: DJANGO_DEBUG=False, a real 50+ char random DJANGO_SECRET_KEY
#   (generate: python -c "import secrets; print(secrets.token_urlsafe(64))"),
# DJANGO_ALLOWED_HOSTS / CORS / CSRF to your real domain(s) only (drop localhost;
#   the Render hostname is trusted automatically, add your Vercel URL to CORS+CSRF),
# and serve over HTTPS. Set this to True ONLY when behind a TLS-terminating proxy
# (Nginx, load balancer, PaaS) that sets X-Forwarded-Proto (Render does):
DJANGO_BEHIND_PROXY=False

# OTP delivery: when True, login codes are logged to the console instead of
# being emailed/SMSed (handy for local dev). Defaults to the value of DEBUG.
# Set to False in production once EMAIL_HOST below is configured.
OTP_DELIVERY_CONSOLE=True

# Self-service data export (/api/auth/export). Off for now — data-copy
# requests go through support (see Privacy Policy). Set True to re-enable.
DATA_EXPORT_ENABLED=False

# --- Rate limiting ---
# Global per-client API budgets (per-endpoint limits are in settings.py).
# DRF_ANON_RATE=300/min
# DRF_USER_RATE=240/min
# Trusted proxies in front of Django, so anon limits key to the REAL client IP:
# 0 locally; 1 on Render (its load balancer). Set by render.yaml in production.
# DJANGO_NUM_PROXIES=0

# --- Abuse response ---
# Emergency IP blocklist: comma-separated IPs rejected before any processing.
# Change it in Render's Environment tab and the service restarts with it live.
# DJANGO_BLOCKED_IPS=203.0.113.7,198.51.100.9
# Circuit breaker: max login codes the WHOLE system sends per hour (0 = off).
# Caps the email/SMS bill even under a distributed flood.
# OTP_GLOBAL_HOURLY_CAP=500

# --- Email (login codes + security alerts) ---
# Any SMTP provider. Unset EMAIL_HOST = emails print to the console instead.
# Example values are for Resend (free tier: smtp.resend.com, user "resend",
# password = your API key):
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxxxxx
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Luxeit <login@yourdomain.com>

# ── Google Sign-In ───────────────────────────────────────────────────────────
# The OAuth *web* client ID from Google Cloud → Google Auth Platform → Clients.
# The backend verifies Google ID tokens against it. Must match the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. Unset = /api/auth/google returns 503 (disabled).
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Cloudflare R2 media storage (uploaded product photos) -------------------
# Leave R2_BUCKET empty and uploads stay on the local disk (backend/media/),
# served by the dev server — no configuration needed for local development.
# Set all of these in Render to store uploads in R2 instead.
# R2_BUCKET=luxeit-media
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_token_access_key
# R2_SECRET_ACCESS_KEY=your_r2_token_secret
# Public host serving the bucket, no scheme (r2.dev URL or a custom domain).
# Must match MEDIA_HOST in the frontend.
# R2_PUBLIC_HOST=pub-xxxxxxxx.r2.dev
